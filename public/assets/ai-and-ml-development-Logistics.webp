<script defer src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.8/js/bootstrap.bundle.min.js" integrity="sha512-HvOjJrdwNpDbkGJIG2ZNqDlVqMo77qbs4Me4cah0HoDrfhrbA+8SBlZn1KrvAQw7cILLPFJvdwIgphzQmMm+Pw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script defer src="https://invoidea.com/service08/assets/js/newjs.min.js"></script>
<script>
    // Skeleton removal (moved from <head> to avoid render-blocking)
    window.addEventListener('load', function() {
        document.querySelectorAll('.skeleton').forEach(function(e) {
            e.classList.remove('skeleton');
            e.classList.add('content');
        });
    });

    // Lazy-load SweetAlert2 only when needed
    var _swalLoaded = false;
    var _swalCallbacks = [];
    function loadSwal(cb) {
        if (typeof Swal !== 'undefined') { if (cb) cb(); return; }
        if (_swalLoaded) { _swalCallbacks.push(cb); return; }
        _swalLoaded = true;
        _swalCallbacks.push(cb);
        var s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.23.0/sweetalert2.min.js';
        s.crossOrigin = 'anonymous';
        s.onload = function() { _swalCallbacks.forEach(function(fn) { if (fn) fn(); }); _swalCallbacks = []; };
        document.head.appendChild(s);
    }

    function Notify(msg, status) {
        loadSwal(function() {
            Swal.fire({ icon: status ? 'success' : 'error', title: status ? 'Thank You!' : 'Oops!', text: msg });
        });
    }

    // jQuery-dependent code — runs after jQuery loads via defer ordering
    document.addEventListener('DOMContentLoaded', function () {
        // Wait for jQuery to be ready (loaded via defer, guaranteed before DOMContentLoaded scripts execute after it)
        if (!window.jQuery) return;
        var $ = window.jQuery;

        // Sidebar modal toggles
        $(".burger-menu,.header-enq-menu").on('click', function() {
            $('.sidebar-modal').toggleClass('active');
        });
        $(".contact-modal-btn").on('click', function() {
            $('.sidebar-modal').toggleClass('active');
        });
        $(".sidebar-modal-close-btn").on('click', function() {
            $('.sidebar-modal').removeClass('active');
        });

        // Custom form submission handler
        $(document).on('submit', '.customFrom', function (e) {

            e.preventDefault();

            let currentForm = $(this);

            // Clear previous errors
            currentForm.find('.text-danger').html('');

            currentForm.addClass('was-validated');

            if (!currentForm[0].checkValidity()) {
                e.stopPropagation();
                return false;
            }

            // For tel fields: combine country code + digits-only number, then exclude code dropdown from submit
            currentForm.find('input[data-tel-field], input.customform-tel-number').each(function() {
                var telInput = this;
                var codeSelect = currentForm.find('select[name="' + telInput.name + '_country_code"]')[0];
                if (codeSelect) {
                    var code = (codeSelect.value || '').trim();
                    var num = (telInput.value || '').replace(/\D/g, '');
                    telInput.value = code ? (code + ' ' + num) : num;
                    codeSelect.setAttribute('data-tel-code-name', codeSelect.getAttribute('name'));
                    codeSelect.removeAttribute('name');
                }
            });

            // IMPORTANT: Use FormData instead of serialize (includes _token from form)
            let formData = new FormData(currentForm[0]);

            // Restore code select names so form state is intact (e.g. for reset)
            currentForm.find('select[data-tel-code-name]').each(function() {
                this.setAttribute('name', this.getAttribute('data-tel-code-name') || '');
                this.removeAttribute('data-tel-code-name');
            });

            // Use CSRF token from the form so it's always current; add headers so 419 returns JSON
            let csrfToken = currentForm.find('input[name="_token"]').val() || 'Jq7Y0ybeyBapLOcHUl6OWs2ZY4iMrYSVZ4dyhIfJ';

            $.ajax({
                url: "https://invoidea.com/customformhandler",
                method: 'POST',
                data: formData,
                processData: false,   // REQUIRED
                contentType: false,   // REQUIRED
                cache: false,
                headers: {
                    'X-CSRF-TOKEN': csrfToken,
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },

                beforeSend: function () {
                    currentForm.find(":submit")
                        .prop('disabled', true)
                        .html('Submitting...');
                },

                success: function (response) {

                    if (response.status == 400) {

                        $.each(response.message, function (i, v) {
                            $('.' + i + '-error').html(v);
                        });

                    } else if (response.status == 201) {

                        loadSwal(function() {
                            Swal.fire({ icon: 'error', title: 'Sorry!', text: 'You can not make enquiry' });
                        });
                        currentForm.trigger("reset");

                    } else if (response.status == 1) {

                        window.location.replace("https://invoidea.com/thank-you-success");

                    } else {

                        window.location.replace("https://invoidea.com/thank-you-success");
                    }
                },

                error: function (xhr) {
                    var msg = 'Something went wrong. Please try again.';
                    if (xhr.status === 419) msg = 'Session expired or invalid. Please refresh the page and try again.';
                    else if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                    loadSwal(function() {
                        Swal.fire({ icon: 'error', title: 'Error!', text: msg });
                    });
                },

                complete: function () {
                    currentForm.removeClass('was-validated');
                    currentForm.find(":submit")
                        .prop('disabled', false)
                        .html('Submit');
                }
            });

        });
    });

// Contact form handler (Fetch API based — no jQuery dependency)
document.addEventListener('DOMContentLoaded', function () {
  const form = document.getElementById('contactForm');
  const button = document.querySelector('.enqBtn');
  const phoneInput = document.getElementById('enq_phone');

  if (!form || !button) return;

  // Restrict phone input to digits only (no +, spaces, or other special characters)
  if (phoneInput) {
    phoneInput.addEventListener('input', function () {
      this.value = this.value.replace(/\D/g, '');
    });
  }

  button.addEventListener('click', function (e) {
    e.preventDefault();

    // Add Bootstrap validation styling
    form.classList.add('was-validated');
    if (!form.checkValidity()) {
      e.stopPropagation();
      return;
    }

    // Prepare form data (combine country code + phone number; strip non-digits from number)
    const phoneCode = document.getElementById('enq_phone_code')?.value?.trim() || '';
    const phoneNumber = document.getElementById('enq_phone').value.replace(/\D/g, '');
    const data = {
      customers_name: document.getElementById('enq_name').value,
      phone: phoneCode ? (phoneCode + ' ' + phoneNumber) : phoneNumber,
      email_address: document.getElementById('enq_email').value,
      message: document.getElementById('enq_message').value,
      page_source: document.getElementById('enq_page_source').value
    };

    // Disable button and show spinner
    button.disabled = true;
    button.innerHTML = `<i class="fa-solid fa-spinner fa-spin-pulse"></i> Sending...`;

    // CSRF token
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

    // Cache-busting query parameter to avoid NitroPack 302 redirect
    const url = `/contactstoretest?testnitro=1`;

    // Make the AJAX request using Fetch API
    fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'Cache-Control': 'no-cache, no-store, must-revalidate',
        'Pragma': 'no-cache',
        'Expires': '0',
        ...(csrfToken ? { 'X-CSRF-TOKEN': csrfToken } : {})
      },
      body: JSON.stringify(data),
      credentials: 'same-origin' // keep session/cookies if needed
    })
    .then(response => {
      // Detect redirect (302 handling) – should be avoided by server for AJAX
      if (response.redirected) {
        console.warn("Redirected to:", response.url);
        throw new Error('Request was redirected (302). Please refresh the page and try again.');
      }

      // 419 = session/CSRF expired – show message and optionally reload
      if (response.status === 419) {
        return response.json().then(body => {
          throw { status: 419, message: body.message || 'Session expired. Please refresh the page and try again.' };
        });
      }

      return response.json();
    })
    .then(res => {
      if (res.status === 400) {
        Object.entries(res.error).forEach(([key, val]) => {
          const field = document.getElementById(`enq_${key}`);
          if (field) field.classList.add('is-invalid');
        });
      } else if (res.status === 201) {
        document.querySelector('.contact-error-alert')?.classList.remove('d-none');
      } else {
        document.querySelector('.contact-alert')?.classList.remove('d-none');
        form.reset();
      }
    })
    .catch(error => {
      console.error("AJAX Error:", error);
      const msg = error.message || 'Something went wrong. Please try again.';
      if (error.status === 419 || (error.message && error.message.includes('redirected'))) {
        document.querySelector('.contact-error-alert')?.classList.remove('d-none');
        const alertEl = document.querySelector('.contact-error-alert');
        if (alertEl) alertEl.textContent = msg;
      }
    })
    .finally(() => {
      button.disabled = false;
      button.innerHTML = 'Send Message';
      form.classList.remove('was-validated');
    });
  });
});

</script>            <script> window.dataLayer=window.dataLayer||[],window.gtag=window.gtag||function(){dataLayer.push(arguments)},gtag("js",new Date),gtag("config","G-HYFZY7YF43",{send_page_view:!0}),function(){let e=!1;function t(){if(e)return;e=!0;const t=document.createElement("script");t.async=!0,t.src="https://www.googletagmanager.com/gtag/js?id=G-HYFZY7YF43",document.head.appendChild(t),["scroll","mousemove","touchstart","pointerdown","keydown"].forEach(function(e){window.removeEventListener(e,t,{passive:!0})})}["scroll","mousemove","touchstart","pointerdown","keydown"].forEach(function(e){window.addEventListener(e,t,{once:!0,passive:!0})}),setTimeout(t,5e3)}();</script> <script type="application/ld+json">
